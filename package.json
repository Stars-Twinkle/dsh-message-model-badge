{
  "name": "@stars-twinkle/dsh-message-model-badge",
  "version": "1.2.5",
  "description": "Shows the model and reasoning level that produced each reply under the turn in the DSH conversation.",
  "license": "MIT",
  "author": "Stars-Twinkle",
  "homepage": "https://github.com/Stars-Twinkle/dsh-message-model-badge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stars-Twinkle/dsh-message-model-badge.git"
  },
  "bugs": {
    "url": "https://github.com/Stars-Twinkle/dsh-message-model-badge/issues"
  },
  "keywords": ["dsh", "deepseek-harness", "plugin", "bundle", "model", "badge"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
